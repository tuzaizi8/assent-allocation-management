# ========== API 配置 ==========
# 后端服务地址,默认指向本地后端(配合后端仓库的 .env.dev 默认端口)
VITE_APP_API_URL=http://localhost:8000

# ========== Mock 配置 ==========
# 默认关闭 MSW,直连真实后端;需要脱离后端演示时改为 true
VITE_APP_ENABLE_API_MOCKING=false

# ========== 应用配置（可选）==========
VITE_APP_URL=http://localhost:3000
VITE_APP_MOCK_API_PORT=8080

# ========== ICP 备案号（可选）==========
# 部署方资产,不随源码公开;留空则登录/注册页不显示底部备案链接
VITE_APP_ICP_NO=
