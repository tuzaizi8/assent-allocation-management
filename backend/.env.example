# ========== 应用配置 ==========
APP_ENV=dev
APP_NAME=Assent Allocation Management
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ROOT_PATH=/api
APP_RELOAD=true
APP_WORKERS=1

# ========== 数据库配置（PostgreSQL）==========
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=assent_allocation_management
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# ========== Redis 配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========== JWT 配置 ==========
# 生成方式: openssl rand -base64 32
JWT_SECRET_KEY=change-me-base64-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=7200

# ========== 日志配置 ==========
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
LOG_MASK_FIELDS=password,token,secret,api_key,jwt,authorization
LOG_PARTIAL_MASK_FIELDS=phone,email,id_card
